<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_crm_lead_form_inherit_contacts" model="ir.ui.view">
        <field name="name">crm.lead.form.contacts</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet/notebook" position="inside">
                <page string="Contacts">
                    <field name="contact_ids" mode="kanban">
                        <kanban>
                            <field name="name"/>
                            <field name="phone"/>
                            <field name="mobile"/>
                            <field name="email"/>
                            <templates>
                                <t t-name="kanban-box">
                                    <div class="oe_kanban_card">
                                        <div>
                                            <strong><field name="name"/></strong>
                                        </div>
                                        <div><field name="phone"/></div>
                                        <div><field name="mobile"/></div>
                                        <div><field name="email"/></div>
                                    </div>
                                </t>
                            </templates>
                        </kanban>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
