<page string="Contacts">
  <div class="mb-2">
    <button type="object"
            name="action_add_company_contact"
            string="Додати"
            class="btn btn-primary"/>
  </div>

  <field name="contact_ids" mode="kanban" options="{'no_create': True}">
    <kanban>
      <!-- поля которые используются в шаблоне -->
      <field name="name"/>
      <field name="image_128"/>
      <field name="function"/>
      <field name="phone"/>
      <field name="mobile"/>
      <field name="email"/>

      <templates>
        <t t-name="kanban-box">
          <div class="oe_kanban_card">
            <div class="o_kanban_record_top">
              <div class="o_kanban_avatar me-2">
                <img t-att-src="kanban_image('res.partner','image_128', record.id.raw_value)"
                     class="o_kanban_avatar"
                     alt="avatar"/>
              </div>

              <div class="o_kanban_record_head">
                <strong><field name="name"/></strong>
                <div t-if="record.function.raw_value">
                  <span class="text-muted">Посада: </span><field name="function"/>
                </div>
                <div t-if="record.phone.raw_value">
                  <span class="text-muted">Телефон: </span><field name="phone"/>
                </div>
                <div t-if="record.mobile.raw_value">
                  <span class="text-muted">Мобільний: </span><field name="mobile"/>
                </div>
                <div t-if="record.email.raw_value">
                  <span class="text-muted">Ел. пошта: </span><field name="email"/>
                </div>
              </div>
            </div>
          </div>
        </t>
      </templates>
    </kanban>
  </field>
</page>
